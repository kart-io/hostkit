# 所有组件的镜像版本，唯一出处。升级：改这里，再 make <组件>（会按新镜像重建容器）
# 格式 KEY=VALUE，不加引号；单台机器要临时覆盖，在 config.env 或环境变量里设同名变量

# 阶段 2
NGINX_IMAGE=nginx:1.30-alpine
CERTBOT_IMAGE=certbot/certbot:v5.10.0

# 阶段 3
REDIS_IMAGE=redis:8.10-alpine
POSTGRES_IMAGE=postgres:18-alpine
VM_IMAGE=victoriametrics/victoria-metrics:v1.156.0
VL_IMAGE=victoriametrics/victoria-logs:v1.54.0
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.165.0
VMALERT_IMAGE=victoriametrics/vmalert:v1.156.0
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.2
# 飞书告警转发（templates/alert/feishu.py）的运行时
PYTHON_IMAGE=python:3.14-alpine
