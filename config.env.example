# 复制为 config.env 后按需修改；未设置的项使用注释中的默认值

# ---- 阶段 1 ----
# SSH 端口。改成非 22 时会同时监听 22，用新端口登录验证后再设 SSH_CLOSE_OLD_PORT=1
#SSH_PORT=22
#SSH_CLOSE_OLD_PORT=0
# 额外对外放行的 TCP 端口（空格分隔），UFW 与安全组清单都会包含
#EXTRA_TCP_PORTS=""
# Swap 大小（MB）。auto: ≤2G 内存给 2 倍，≤8G 给 1 倍，更大给 4G；0 表示不建
#SWAP_SIZE_MB=auto
#DOCKER_LOG_MAX_SIZE=50m
#DOCKER_LOG_MAX_FILE=3
# Docker apt 源，留空则按云厂商与连通性自动选择
#DOCKER_REPO=""
# 镜像加速（空格分隔）。留空时：Docker Hub 可达就不配；腾讯云不可达则自动用内网加速
#REGISTRY_MIRRORS=""
# 不能与 Docker 网段重叠的内网段（如 VPC 网段、对端 IDC），空格分隔
#AVOID_CIDRS=""

# ---- 阶段 2 ----
#DEPLOY_DIR=/opt/base
#NETWORK_NAME=base-net
# 证书域名（空格分隔，第一个作为证书名）；留空则只跑 HTTP
#DOMAINS="example.com www.example.com"
#LE_EMAIL=""
# 1 = 用 Let's Encrypt 测试环境，调通后改 0 并执行 make purge-tls tls 重新签发
#LE_STAGING=0
# 前面有 CDN/负载均衡、域名不直接解析到本机时设 1
#TLS_SKIP_DNS_CHECK=0

# ---- 阶段 3：可选组件，用 make <组件> 安装，不需要开关 ----
# 镜像版本统一在 versions.env 维护；单台机器要覆盖，在这里设同名变量，如 #REDIS_IMAGE=redis:8.10-alpine
# 保留时长，支持 h/d/w/y 后缀
#VM_RETENTION=30d
#VL_RETENTION=7d

# 告警（make alert）：飞书群机器人 Webhook，留空时告警只打印到 docker logs base-alert-alert-feishu-1
#ALERT_FEISHU_WEBHOOK="https://open.feishu.cn/open-apis/bot/v2/hook/xxxx"
# 机器人开启「签名校验」时填写
#ALERT_FEISHU_SECRET=""

# 备份（make backup）。告警规则按每天备份设定，改成更低频率会触发 BackupNotRunning
#BACKUP_DIR=/var/backups/hostkit
#BACKUP_KEEP=7
#BACKUP_ONCALENDAR="*-*-* 03:30:00"
# 每次备份完成后执行，$1 为本次备份目录，用于复制到异地，如:
#BACKUP_POST_HOOK='rclone copy "$1" remote:hostkit/$(hostname)/$(basename "$1")'
